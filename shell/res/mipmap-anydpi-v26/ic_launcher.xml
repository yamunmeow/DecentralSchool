<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+: the game's square icon, inset so the whole image sits inside the launcher mask. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground>
        <inset android:drawable="@drawable/app_icon" android:inset="16.667%" />
    </foreground>
</adaptive-icon>
