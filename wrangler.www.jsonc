{
	"$schema": "node_modules/wrangler/config-schema.json",
	// npx wrangler deploy -c wrangler.www.jsonc (once; it never needs to change)
	"name": "decentralschool-www",
	"main": "worker/www.ts",
	"compatibility_date": "2026-09-15",
	"routes": [
		{
			"pattern": "www.decentralschool.org",
			"custom_domain": true
		}
	],
	"workers_dev": false,
	"preview_urls": false
}
