---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Sliding Puzzle" description="Slide numbered tiles into order. Pick any grid size.">
  <section class="wrap game-page">
    <a href="/games" class="back-link">← All games</a>
    <h1>Sliding Puzzle</h1>
    <p class="lede">
      This is the 15-puzzle. You can pick any grid size. Slide tiles into number order
      around the one empty space. Click any tile in the same row or column as the empty
      space to slide that whole line. You can also use the arrow keys.
    </p>
    <div id="game-root"></div>
  </section>
</Layout>

<style>
  .game-page {
    padding: 40px 24px 60px;
  }

  .back-link {
    font-family: var(--font-display);
    font-size: 0.65rem;
    color: var(--muted);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--pac-yellow);
  }

  .lede {
    color: var(--muted);
    max-width: 60ch;
  }

  #game-root {
    margin-top: 24px;
    display: flex;
    justify-content: center;
  }

  :global(.sp-wrap) {
    width: 100%;
    max-width: 520px;
  }

  :global(.sp-menu) {
    text-align: center;
    padding: 40px 24px;
    border: 3px solid var(--border);
    background: var(--bg-inset);
  }

  :global(.sp-label) {
    font-family: var(--font-display);
    font-size: 0.7rem;
    color: var(--muted);
    margin-bottom: 1em;
  }

  :global(.sp-size-row) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 1em;
  }

  :global(.sp-size) {
    font-family: var(--font-display);
    font-size: 1.1rem;
    min-width: 4.5em;
  }

  :global(.sp-range) {
    color: var(--muted);
    font-size: 0.8rem;
    margin-bottom: 1.6em;
  }

  :global(.sp-bar) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    font-size: 0.9rem;
  }

  :global(.sp-bar-actions) {
    display: flex;
    gap: 8px;
  }

  :global(.sp-bar-actions .pixel-btn) {
    font-size: 0.55rem;
    padding: 8px 12px;
  }

  :global(.sp-hint) {
    color: var(--muted);
    font-size: 0.8rem;
    margin-bottom: 16px;
  }

  :global(.sp-board) {
    display: grid;
    gap: 4px;
    aspect-ratio: 1;
    background: var(--border);
    border: 3px solid var(--border);
  }

  :global(.sp-tile) {
    background: var(--ghost-orange);
    color: var(--bg-inset);
    border: none;
    font-family: var(--font-display);
    font-size: clamp(0.7rem, 2.4vw, 1.2rem);
    cursor: pointer;
    aspect-ratio: 1;
  }

  :global(.sp-tile.sp-correct) {
    background: #7fd88f;
  }

  :global(.sp-tile.sp-blank) {
    background: var(--bg-inset);
    cursor: default;
  }

  :global(.sp-solved) {
    text-align: center;
    font-family: var(--font-display);
    color: var(--pac-yellow);
    margin-top: 16px;
  }
</style>

<script>
  import { mountSlidingPuzzle } from "../../games/sliding-puzzle/game";
  const root = document.getElementById("game-root");
  if (root) mountSlidingPuzzle(root);
</script>
