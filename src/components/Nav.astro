---
const { pathname } = Astro.url;

const links = [
  { href: "/games", label: "Play" },
  { href: "/learn", label: "Learn" },
  { href: "/explore", label: "Explore" },
  { href: "/resources", label: "Resources" },
];

const isActive = (href: string) => pathname === href || pathname.startsWith(href + "/");
---

<header class="site-nav">
  <div class="wrap nav-inner">
    <a href="/" class="brand" aria-label="DecentralSchool home">
      <span class="pac-mark" aria-hidden="true"></span>
      <span class="brand-text">DecentralSchool</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-list">
        {links.map((link) => (
          <li>
            <a href={link.href} class:list={["nav-link", { active: isActive(link.href) }]}>
              {isActive(link.href) && <span class="cursor" aria-hidden="true">▸</span>}
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg-inset);
    border-bottom: 3px solid var(--border);
    transform: translateY(0);
    transition: transform 0.2s ease;
  }

  .site-nav.nav-hidden {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav {
      transition: none;
    }
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .pac-mark {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--pac-yellow);
    clip-path: polygon(100% 74%, 44% 50%, 100% 26%, 100% 0, 0 0, 0 100%, 100% 100%);
    flex-shrink: 0;
  }

  .nav-list {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .nav-link {
    font-family: var(--font-display);
    font-size: 0.65rem;
    color: var(--muted);
    text-decoration: none;
    padding: 10px 12px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--pac-yellow);
  }

  .nav-link.active {
    color: var(--pac-yellow);
  }

  .cursor {
    color: var(--pac-yellow);
    animation: blink 1s steps(2) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @media (max-width: 640px) {
    .nav-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .nav-list {
      gap: 0;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>(".site-nav");
  if (nav) {
    let lastY = window.scrollY;
    let ticking = false;
    const hideAfter = 80; // px scrolled before the bar is allowed to hide

    const update = () => {
      const y = window.scrollY;
      if (y > lastY && y > hideAfter) {
        nav.classList.add("nav-hidden");
      } else {
        nav.classList.remove("nav-hidden");
      }
      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
  }
</script>
